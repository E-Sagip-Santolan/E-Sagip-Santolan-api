Table users {
  id bigint [pk, increment]
  name varchar [not null]
  email varchar [unique, not null]
  password varchar [not null]
  role varchar [not null, default: 'volunteer', note: 'volunteer, admin or superadmin']
  status varchar [not null, default: 'pending', note: 'pending, approved or rejected']
  rejection_reason varchar
  approved_by bigint [ref: > users.id]
  approved_at timestamp
  is_active boolean [not null, default: true]
  created_at timestamp
  updated_at timestamp
}

Table volunteer_profiles {
  id bigint [pk, increment]
  user_id bigint [unique, not null, ref: - users.id]
  contact_number varchar [not null]
  address_area varchar [not null]
  birthdate date [not null]
  is_resident boolean [not null]
  availability varchar [not null, default: 'available', note: 'available, unavailable or on_operation']
  training text
  created_at timestamp
  updated_at timestamp
}

Table skills {
  id bigint [pk, increment]
  name varchar [unique, not null]
  category varchar [not null]
  created_at timestamp
  updated_at timestamp
}

Table volunteer_skills {
  user_id bigint [not null, ref: > users.id]
  skill_id bigint [not null, ref: > skills.id]
  indexes {
    (user_id, skill_id) [pk]
  }
}

Table admin_permissions {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  permission varchar [not null, note: 'volunteer_approvals, operation_management, attendance_confirmation, community_publishing, reports_exports or activity_logs']
  indexes {
    (user_id, permission) [unique]
  }
}

Table consent_records {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  policy_version varchar [not null]
  accepted_at timestamp [not null]
}

Table activity_logs {
  id bigint [pk, increment]
  user_id bigint [ref: > users.id]
  action varchar [not null]
  module varchar [not null]
  details text
  ip_address varchar(45)
  created_at timestamp [not null]
}

Table operations {
  id bigint [pk, increment]
  title varchar [not null]
  description text
  location varchar [not null]
  starts_at timestamp [not null]
  volunteer_slots int [not null]
  status varchar [not null, default: 'scheduled', note: 'scheduled, completed or cancelled']
  checkin_code varchar
  created_by bigint [ref: > users.id]
  created_at timestamp
  updated_at timestamp
}

Table operation_skills {
  operation_id bigint [not null, ref: > operations.id]
  skill_id bigint [not null, ref: > skills.id]
  indexes {
    (operation_id, skill_id) [pk]
  }
}

Table signups {
  id bigint [pk, increment]
  operation_id bigint [not null, ref: > operations.id]
  user_id bigint [not null, ref: > users.id]
  status varchar [not null, default: 'signed_up', note: 'signed_up or cancelled']
  created_at timestamp
  indexes {
    (operation_id, user_id) [unique]
  }
}

Table safety_acknowledgments {
  id bigint [pk, increment]
  signup_id bigint [unique, not null, ref: - signups.id]
  reminder_version varchar [not null]
  acknowledged_at timestamp [not null]
}

Table attendance {
  id bigint [pk, increment]
  signup_id bigint [unique, not null, ref: - signups.id]
  checkin_at timestamp
  checkout_at timestamp
  status varchar [not null, default: 'pending', note: 'pending, confirmed, rejected or absent']
  source varchar [not null, default: 'app', note: 'app or manual']
  confirmed_by bigint [ref: > users.id]
  confirmed_at timestamp
}

Table community_items {
  id bigint [pk, increment]
  type varchar [not null, note: 'announcement, advisory or emergency_alert']
  title varchar [not null]
  body text [not null]
  status varchar [not null, default: 'draft', note: 'draft, published or archived']
  published_by bigint [ref: > users.id]
  published_at timestamp
  created_at timestamp
  updated_at timestamp
}

Table evacuation_centers {
  id bigint [pk, increment]
  name varchar [not null]
  address varchar [not null]
  notes text
  updated_at timestamp
}

Table emergency_contacts {
  id bigint [pk, increment]
  name varchar [not null]
  phone_number varchar [not null]
  category varchar
  updated_at timestamp
}

Table preparedness_tips {
  id bigint [pk, increment]
  title varchar [not null]
  body text [not null]
  source varchar
  updated_at timestamp
}
