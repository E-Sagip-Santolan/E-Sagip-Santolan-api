{
  "info": {
    "name": "E-Sagip API (Phase 2)",
    "description": "Phase 2 REST API collection for E-Sagip (Barangay Santolan). Uses {{base_url}} and {{token}} variables. All sample bodies use dummy data from docs/api.md.",
