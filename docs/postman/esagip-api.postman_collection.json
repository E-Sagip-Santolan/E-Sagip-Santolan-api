            "url": {
              "raw": "{{base_url}}/volunteers?status=pending&page=1&per_page=15",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "volunteers"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "pending",
                  "description": "pending, approved, or rejected"
                },
                {
                  "key": "skill",
                  "value": "1",
                  "disabled": true,
                  "description": "Skill ID"
                },
                {
                  "key": "availability",
                  "value": "available",
                  "disabled": true,
                  "description": "available, unavailable, or on_operation"
                },
                {
                  "key": "address_area",
                  "value": "Zone 1",
                  "disabled": true,
                  "description": "Filter by area"
                },
                {
                  "key": "search",
                  "value": "juan",
                  "disabled": true,
                  "description": "Search name, email, or contact_number"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "per_page",
                  "value": "15"
                }
              ]
            },
            "description": "Admin with volunteer_approvals or superadmin. Returns paginated volunteers including contact details."
